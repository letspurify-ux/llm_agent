# MariaDB (agent 관리 DB)
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=agent
MARIADB_PASSWORD=agent1234
MARIADB_DATABASE=llm_agent

# LLM 선택 — mock: 규칙 기반 Mock / openai: vLLM·OpenRouter 등 OpenAI 호환 API
LLM_PROVIDER=mock
# vLLM 예시: http://localhost:8000/v1  /  OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:8000/v1
# vLLM은 보통 불필요(빈 값이면 Authorization 헤더 생략), OpenRouter는 필수
LLM_API_KEY=
# 예: Qwen/Qwen2.5-32B-Instruct (vLLM) / anthropic/claude-sonnet-4.5 (OpenRouter)
LLM_MODEL=

# Oracle 조회 DB — 1이면 실제 접속 없이 stub 결과 반환 (개발용)
ORACLE_MOCK=1
# 조회 쿼리 타임아웃(ms). 느린 쿼리가 요청을 붙잡지 않게 한다
ORACLE_TIMEOUT_MS=30000
# target_db.db_password='ENV:ORDER_DB_PASSWORD' 가 참조하는 값.
# 아래 기본값은 로컬 테스트 컨테이너용 계정(oracle-init.sql이 만드는 VOC_READER) 비밀번호다 — 운영에서는 반드시 교체할 것
ORDER_DB_PASSWORD=voc_reader_1234

PORT=3001

# 로컬 임베딩 (Ollama 등 OpenAI 호환). 미설정/미기동이면 LIKE 검색만 사용 (자동 폴백)
EMBEDDING_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
# 임베딩 diff 동기화 주기(초). 0이면 서버 내 주기 동기화 끔
EMBED_SYNC_INTERVAL=60
