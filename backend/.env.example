# MariaDB (agent 관리 DB)
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=agent
# README의 앱 계정 생성 단계에서 직접 정한 비밀번호를 채운다. 비워 두면 서버가 기동 로그로 알려준다.
# (기본값을 비워 두는 이유: 채워 두면 "여기는 내가 채워야 한다"는 신호가 사라져
#  저장소에 공개된 비밀번호가 운영까지 따라간다 — ORDER_DB_PASSWORD와 같은 규칙)
MARIADB_PASSWORD=
MARIADB_DATABASE=llm_agent
# 커넥션 풀 크기. 비워 두면 db.js가 근거(요청당 4개 × 동시 질문 4건 + 동기화 락 1개)로 계산한다 —
# 여기에 수를 적어 두면 그 사본이 코드의 식을 덮어써서, 식을 고쳐도 새 설치에는 반영되지 않는다
# (그 어긋남은 '동시 사용자가 조금 늘면 500'으로만 드러나고 원인을 가리키지 않는다).
# 계산값을 바꿔야 할 때만 채운다.
MARIADB_POOL_SIZE=
# 관리 DB 조회 타임아웃(ms). 느린 검색·락 대기가 요청을 무한정 붙잡지 않게 한다 (비우면 기본 30000).
# 접속 시 SET max_statement_time으로 한 번 걸리므로 쿼리 문자열에는 영향이 없다.
MARIADB_TIMEOUT_MS=30000

# LLM 선택 — mock: 규칙 기반 Mock / openai: vLLM·OpenRouter 등 OpenAI 호환 API
LLM_PROVIDER=mock
# vLLM 예시: http://localhost:8000/v1  /  OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:8000/v1
# vLLM은 보통 불필요(빈 값이면 Authorization 헤더 생략), OpenRouter는 필수
LLM_API_KEY=
# 예: Qwen/Qwen2.5-32B-Instruct (vLLM) / anthropic/claude-sonnet-4.5 (OpenRouter)
LLM_MODEL=
# 추론 강도: low(기본) | medium | high | off(파라미터를 보내지 않음).
# 매 스텝 결정 JSON 하나만 받으면 되고 판단 근거는 프롬프트에 이미 들어가므로 low로 충분하다.
# 왕복 지연이 스텝 수만큼 곱해지는 구조라 이 값이 체감 응답 속도를 크게 좌우한다.
LLM_REASONING_EFFORT=low

# Oracle 조회 DB — 1이면 실제 접속 없이 stub 결과 반환 (개발용)
ORACLE_MOCK=1
# 드라이버 모드 — thin(기본): 드라이버가 직접 접속, Oracle Instant Client 설치 불필요
#                 oci: node-oracledb Thick 모드, 이 머신에 설치된 Oracle Client 라이브러리 경유
#                      (사내 표준이 OCI이거나 thin이 지원하지 않는 접속 방식을 써야 할 때)
# 모르는 값은 thin으로 되돌리고 경고를 남긴다 (같은 DB에 붙으므로 조용한 오답은 생기지 않는다).
ORACLE_DRIVER=thin
# oci 모드에서 Instant Client(libclntsh) 디렉터리. 비우면 OS 기본 검색 경로를 따른다
# (Linux: LD_LIBRARY_PATH·ldconfig / Windows: PATH / macOS: ~/lib) — 보통 비워 두면 된다.
# 셸에서 이미 export한 같은 이름의 값이 있으면 그쪽이 이긴다 (dotenv는 기존 환경변수를 덮지 않는다).
# thin 모드에서는 쓰이지 않는다.
ORACLE_CLIENT_LIB_DIR=
# oci 모드에서 tnsnames.ora·sqlnet.ora가 있는 디렉터리. 비우면 TNS_ADMIN 환경변수를 따른다.
# 접속 단계 타임아웃도 oci에서는 여기의 sqlnet.ora로 준다 (코드의 connectTimeout은 thin 전용).
# thin 모드에서는 쓰이지 않는다 (thin은 TNS_ADMIN을 직접 읽는다).
ORACLE_CLIENT_CONFIG_DIR=
# 조회 쿼리 타임아웃(ms). 느린 쿼리가 요청을 붙잡지 않게 한다 (비우면 기본 30000)
ORACLE_TIMEOUT_MS=30000
# target_db.db_password='ENV:ORDER_DB_PASSWORD' 가 참조하는 값 — ORACLE_MOCK=0으로 쓸 때 채운다.
# 로컬 테스트 컨테이너는 oracle-init.sql이 만드는 VOC_READER 계정의 비밀번호를 그대로 쓴다.
# (기본값을 비워 두는 이유: 채워 두면 "여기는 내가 채워야 한다"는 신호가 사라져 알려진 비밀번호가 운영까지 따라간다)
ORDER_DB_PASSWORD=

PORT=3001

# 로컬 임베딩 (Ollama 등 OpenAI 호환). 미기동이면 LIKE 검색만 사용 (자동 폴백).
# Ollama를 쓰지 않는다면 이 줄을 비워 두면 임베딩 시도 자체를 건너뛴다 (매 주기 스캔 비용 절약)
EMBEDDING_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
# 임베딩 diff 동기화 주기(초). 0이면 서버 내 주기 동기화 끔 (비우거나 숫자가 아니면 기본 60)
EMBED_SYNC_INTERVAL=60
