{
  "name": "llm-agent-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/ensure-env.js && node src/server.js",
    "embed": "node src/embed-sync.js",
    "test": "node --test test/*.test.js ../scripts/*.test.cjs",
    "test:integration": "node --test test/integration/*.test.js",
    "test:oracle": "node --test test/oracle/*.test.js",
    "test:all": "npm test && npm run test:integration && npm run test:oracle"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mariadb": "^3.3.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "oracledb": "^6.6.0"
  },
  "overrides": {
    "body-parser": "1.20.8",
    "qs": "6.16.0"
  }
}
