{
  "name": "llm-agent-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "node --test --test-concurrency=1 test/ui/ui.test.mjs",
    "test:production": "node --test test/ui/production.test.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:production",
    "test:regression": "node test/run-regressions.mjs"
  },
  "dependencies": {
    "hast-util-from-html-isomorphic": "^2.0.0",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^7.3.6"
  }
}
